# Токен бота MAX. Обязателен; не публикуйте его в Git.
BOT_TOKEN=

# ID администраторов MAX: JSON-массив положительных чисел.
# Администратор загружает вопросы файлами r1.txt, r2.txt, r3.txt.
# Аудио: r2_N.mp3. Изображения: r3_N.jpg. Инструкция: /help.
# Для проверки раундов: /next_round [код команды].
ADMIN_IDS=[]

# Относительные пути считаются от корня проекта.
DATABASE_PATH=data/bot.sqlite3
LOG_FILE=logs/bot.log
LOG_LEVEL=INFO
